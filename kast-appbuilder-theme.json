                      "styles": {
                        "root": {
                          "boxSizing": "border-box",
                          "width": "100%",
                          "&:has(> section)": {
                            "display": "grid",
                            "gridTemplateColumns": "auto minmax(0, 1fr) auto auto",
                            "grid-template-columns": "auto minmax(0, 1fr) auto auto",
                            "alignContent": "center",
                            "alignItems": "center",
                            "align-content": "center",
                            "align-items": "center",
                            "columnGap": "12px",
                            "overflow": "hidden",
                            "textAlign": "center",
                            "text-align": "center",
                            "justifyContent": "stretch",
                            "padding": "12px",
                            "width": "100%"
                          },
                          "&:has(> section) > section": {
                            "minWidth": 0
                          },
                          "&:has(> section) > section:nth-of-type(1)": {
                            "gridColumn": "1",
                            "grid-column": "1",
                            "justifySelf": "start",
                            "justify-self": "start"
                          },
                          "&:has(> section) > section:nth-of-type(2)": {
                            "gridColumn": "3",
                            "grid-column": "3",
                            "justifySelf": "end",
                            "justify-self": "end",
                            "marginLeft": "auto",
                            "margin-left": "auto",
                            "minWidth": 0
                          },
                          "&:has(> section) > section:nth-of-type(3)": {
                            "gridColumn": "4",
                            "grid-column": "4",
                            "justifySelf": "end",
                            "justify-self": "end"
                          },
                          "& > section > .mantine-Paper-root": {
                            "backgroundColor": "transparent !important",
                            "boxShadow": "none !important",
                            "padding": "0 !important"
                          },
                          "& > section:first-of-type": {
                            "gridColumn": "1",
                            "grid-column": "1",
                            "justifySelf": "start",
                            "justify-self": "start"
                          },
                          "& > section:first-of-type .mantine-Group-root": {
                            "--group-align": "center",
                            "--group-gap": "12px",
                            "--group-justify": "flex-start",
                            "--group-wrap": "nowrap",
                            "alignItems": "center",
                            "display": "flex",
                            "flexWrap": "nowrap",
                            "justifyContent": "flex-start"
                          },
                          "& > section:first-of-type button": {
                            "--button-bg": "#ffffff !important",
                            "--button-bd": "1px solid #d9d9d9 !important",
                            "--button-color": "#2b2b2b !important",
                            "--button-hover": "#f7f7f7 !important",
                            "backgroundColor": "#ffffff !important",
                            "border": "1px solid #d9d9d9 !important",
                            "color": "#2b2b2b !important",
                            "borderRadius": "999px",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "& > *:nth-child(1) button, & > *:nth-child(1) .mantine-Button-root, & > *:nth-child(2) button, & > *:nth-child(2) .mantine-Button-root": {
                            "--button-bg": "#ffffff !important",
                            "--button-bd": "1px solid #d9d9d9 !important",
                            "--button-color": "#2b2b2b !important",
                            "--button-hover": "#f7f7f7 !important",
                            "backgroundColor": "#ffffff !important",
                            "border": "1px solid #d9d9d9 !important",
                            "borderRadius": "999px",
                            "color": "#2b2b2b !important",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "& > section:nth-of-type(2)": {
                            "gridColumn": "3",
                            "grid-column": "3",
                            "justifySelf": "end",
                            "justify-self": "end",
                            "marginLeft": "auto",
                            "margin-left": "auto",
                            "minWidth": 0
                          },
                          "& > section:nth-of-type(2) .mantine-Paper-root": {
                            "backgroundColor": "transparent !important",
                            "marginLeft": "auto",
                            "margin-left": "auto",
                            "padding": "0 !important"
                          },
                          "&:has(> .mantine-Paper-root) > .mantine-Paper-root": {
                            "backgroundColor": "transparent !important",
                            "boxShadow": "none !important",
                            "marginLeft": "auto",
                            "margin-left": "auto",
                            "padding": "0 !important"
                          },
                          "&:has(> .mantine-Paper-root) > button": {
                            "marginLeft": "12px",
                            "margin-left": "12px"
                          },
                          "&:has(> .mantine-Paper-root) > button:not(:last-of-type)": {
                            "--button-bg": "#ffffff !important",
                            "--button-bd": "1px solid #d9d9d9 !important",
                            "--button-color": "#2b2b2b !important",
                            "--button-hover": "#f7f7f7 !important",
                            "backgroundColor": "#ffffff !important",
                            "border": "1px solid #d9d9d9 !important",
                            "borderRadius": "999px",
                            "color": "#2b2b2b !important",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "&:has(> .mantine-Paper-root) > button:last-of-type": {
                            "--button-bg": "var(--mantine-color-kastNeutral-filled) !important",
                            "--button-bd": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "--button-color": "#ffffff !important",
                            "--button-hover": "var(--mantine-color-kastNeutral-filled-hover) !important",
                            "backgroundColor": "var(--mantine-color-kastNeutral-filled) !important",
                            "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "borderRadius": "999px",
                            "color": "#ffffff !important",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "& > section:nth-of-type(2) *": {
                            "fontSize": "1.5rem",
                            "fontWeight": 700,
                            "lineHeight": "1.1",
                            "whiteSpace": "nowrap"
                          },
                          "& > section:nth-of-type(2) p, & > section:nth-of-type(2) span": {
                            "fontSize": "1rem",
                            "fontWeight": 400
                          },
                          "& > section:nth-of-type(2) strong, & > section:nth-of-type(2) b, & > section:nth-of-type(2) h1, & > section:nth-of-type(2) h2, & > section:nth-of-type(2) h3": {
                            "fontSize": "1.5rem",
                            "fontWeight": 700
                          },
                          "& > section:last-of-type": {
                            "gridColumn": "4",
                            "grid-column": "4",
                            "justifySelf": "end",
                            "justify-self": "end"
                          },
                          "& > section:last-of-type .mantine-Group-root": {
                            "--group-align": "center",
                            "--group-gap": "12px",
                            "--group-justify": "flex-end",
                            "--group-wrap": "nowrap",
                            "alignItems": "center",
                            "display": "flex",
                            "flexWrap": "nowrap",
                            "justifyContent": "flex-end"
                          },
                          "& > section:last-of-type button": {
                            "--button-bg": "var(--mantine-color-kastNeutral-filled) !important",
                            "--button-bd": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "--button-color": "#ffffff !important",
                            "--button-hover": "var(--mantine-color-kastNeutral-filled-hover) !important",
                            "backgroundColor": "var(--mantine-color-kastNeutral-filled) !important",
                            "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "color": "#ffffff !important",
                            "borderRadius": "999px",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "& > *:nth-child(3) button, & > *:nth-child(3) .mantine-Button-root, & > *:last-child button, & > *:last-child .mantine-Button-root": {
                            "--button-bg": "var(--mantine-color-kastNeutral-filled) !important",
                            "--button-bd": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "--button-color": "#ffffff !important",
                            "--button-hover": "var(--mantine-color-kastNeutral-filled-hover) !important",
                            "backgroundColor": "var(--mantine-color-kastNeutral-filled) !important",
                            "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "borderRadius": "999px",
                            "color": "#ffffff !important",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          },
                          "& > button:last-of-type": {
                            "--button-bg": "var(--mantine-color-kastNeutral-filled) !important",
                            "--button-bd": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "--button-color": "#ffffff !important",
                            "--button-hover": "var(--mantine-color-kastNeutral-filled-hover) !important",
                            "backgroundColor": "var(--mantine-color-kastNeutral-filled) !important",
                            "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent !important",
                            "borderRadius": "999px",
                            "color": "#ffffff !important",
                            "fontSize": "0.875rem",
                            "fontWeight": 500,
                            "height": "2.5rem",
                            "paddingInline": "1.25rem"
                          }
                        }
                      }
                    }
