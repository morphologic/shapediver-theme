{
  "version": "1.0",
  "themeOverrides": {
    "fontFamily": "Inter, Arial, sans-serif",
    "defaultRadius": "6px",
    "primaryColor": "kastNeutral",
    "colors": {
      "kastNeutral": [
        "#f7f7f7",
        "#f0f0f0",
        "#e3e3e3",
        "#cdcdcd",
        "#a8a8a8",
        "#6d6d6d",
        "#4b4b4b",
        "#3d3d3d",
        "#2b2b2b",
        "#1d1d1d"
