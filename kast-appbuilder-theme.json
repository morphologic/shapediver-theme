          "columns": 4,
          "rows": 12,
          "rightColumns": 1,
          "bottomRows": 1,
          "bottomFullWidth": false,
          "rightBorder": false,
          "keepBottomInGrid": true
        }
      },
      "AppBuilderVerticalContainer": {
        "defaultProps": {
          "p": 4,
          "gap": 4
        }
      },
