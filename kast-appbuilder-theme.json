                            "styles": {
                              "root": {
                                "lineHeight": "1.1",
                                "marginBottom": "0"
                              }
                            }
                          },
                          "Text": {
                            "defaultProps": {
                              "mb": 0
                            },
                            "styles": {
                              "root": {
                                "fontSize": "1.5rem",
                                "marginBottom": "0"
                              }
                            }
                          }
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
