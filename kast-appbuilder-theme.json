                  "AppBuilderHorizontalContainer": {
                    "defaultProps": {
                      "w": "100%",
                      "h": "100%",
                      "justify": "space-between",
                      "align": "center",
                      "gap": 12,
                      "wrap": "nowrap",
                      "p": 12,
                      "pt": 0,
                      "pb": 0,
                      "style": {
                        "--group-align": "center",
                        "--group-gap": "12px",
                        "--group-justify": "space-between",
                        "boxSizing": "border-box",
                        "height": "100%",
                        "width": "100%"
