                    "defaultProps": {
                      "align": "center",
                      "gap": 12,
                      "justify": "space-between",
                      "wrap": "nowrap",
                      "style": {
                        "--group-align": "center",
                        "--group-gap": "12px",
                        "--group-justify": "space-between"
                      },
                      "styles": {
                        "root": {
                          "boxSizing": "border-box",
                          "width": "100%"
