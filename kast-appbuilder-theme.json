{
  "version": "1.0",
  "themeOverrides": {
    "fontFamily": "Inter, Arial, sans-serif",
    "defaultRadius": "6px",
    "breakpoints": {
      "anchorAlways": "0em"
    },
    "primaryColor": "kastNeutral",
    "colors": {
      "kastNeutral": [
        "#f7f7f7",
        "#f0f0f0",
        "#e3e3e3",
        "#cdcdcd",
        "#a8a8a8",
        "#6d6d6d",
        "#4b4b4b",
        "#3d3d3d",
        "#2b2b2b",
        "#1d1d1d"
      ]
    },
    "black": "#2b2b2b",
    "white": "#f0f0f0",
    "fontSizes": {
      "xs": "0.75rem",
      "sm": "0.875rem",
      "md": "0.875rem",
      "lg": "1.25rem",
      "xl": "1.5rem"
    },
    "headings": {
      "fontFamily": "Inter, Arial, sans-serif",
      "fontWeight": "600"
    },
    "other": {
      "forceColorScheme": "light",
      "defaultFontWeight": "400",
      "defaultFontWeightMedium": "500",
      "defaultFontWeightBold": "700"
    },
    "components": {
      "AppBuilderTemplateSelector": {
        "defaultProps": {
          "template": "appshell"
        }
      },
      "AppBuilderAppShellTemplatePage": {
        "defaultProps": {
          "headerHeight": {
            "base": "4.75rem",
            "md": "4rem"
          },
          "navbarBreakpoint": "md",
          "navbarWidth": {
            "base": "100%",
            "md": 360,
            "lg": 360
          },
          "columns": 4,
          "rows": {
            "base": 14,
            "md": 12
          },
          "rightColumns": 1,
          "bottomRows": {
            "base": 6,
            "md": 2,
            "lg": 1
          },
          "bottomFullWidth": false,
          "rightBorder": false,
          "keepBottomInGrid": true
        }
      },
      "AppBuilderVerticalContainer": {
        "defaultProps": {
          "p": 4,
          "gap": 4
        }
      },
      "AppBuilderContainerWrapper": {
        "defaultProps": {
          "containerThemeOverrides": {
            "appshell": {
              "right": {
                "white": "#f0f0f0",
                "colors": {
                  "gray": [
                    "#f7f7f7",
                    "#f0f0f0",
                    "#e3e3e3",
                    "#cdcdcd",
                    "#a8a8a8",
                    "#6d6d6d",
                    "#4b4b4b",
                    "#3d3d3d",
                    "#2b2b2b",
                    "#1d1d1d"
                  ]
                },
                "components": {
                  "Paper": {
                    "defaultProps": {
                      "withBorder": false,
                      "shadow": "none",
                      "bg": "#f0f0f0"
                    }
                  }
                }
              },
              "bottom": {
                "components": {
                  "Paper": {
                    "defaultProps": {
                      "withBorder": false,
                      "shadow": "none",
                      "bg": "#f0f0f0",
                      "p": {
                        "base": 0,
                        "md": 12
                      },
                      "w": {
                        "base": "100%",
                        "md": "auto"
                      },
                      "px": 0,
                      "py": 0
                    }
                  },
                  "Group": {
                    "defaultProps": {
                      "align": "center",
                      "gap": 12,
                      "justify": "space-between",
                      "wrap": "wrap",
                      "style": {
                        "--group-align": "center",
                        "--group-gap": "12px",
                        "--group-justify": "space-between"
                      },
                      "styles": {
                        "root": {
                          "boxSizing": "border-box",
                          "width": "100%"
                        }
                      }
                    }
                  },
                  "Stack": {
                    "defaultProps": {
                      "gap": 12,
                      "style": {
                        "display": "grid",
                        "gridTemplateColumns": "repeat(auto-fit, minmax(min(100%, 14rem), 1fr))",
                        "alignItems": "center",
                        "width": "100%"
                      }
                    }
                  },
                  "Button": {
                    "defaultProps": {
                      "style": {
                        "maxWidth": "calc(100% - 1.5rem)",
                        "minWidth": 0
                      }
                    }
                  },
                  "AppBuilderHorizontalContainer": {
                    "defaultProps": {
                      "w": "100%",
                      "h": "auto",
                      "justify": "space-between",
                      "align": "center",
                      "gap": 12,
                      "wrap": "wrap",
                      "p": 6,
                      "style": {
                        "boxSizing": "border-box",
                        "width": "100%",
                        "height": "auto",
                        "maxHeight": "100%",
                        "overflow": "clip",
                        "alignItems": "center",
                        "alignContent": "center",
                        "flexWrap": "wrap",
                        "gap": "12px"
                      },
                      "styles": {
                        "root": {
                          "boxSizing": "border-box",
                          "width": "100%",
                          "height": "auto",
                          "maxHeight": "100%",
                          "overflow": "clip",
                          "alignItems": "center",
                          "alignContent": "center",
                          "flexWrap": "wrap",
                          "gap": "12px"
                        }
                      },
                      "display": "flex"
                    }
                  },
                  "AppBuilderFormWidgetComponent": {
                    "defaultProps": {
                      "stackProps": {
                        "gap": 12
                      },
                      "formPaperProps": {
                        "withBorder": false,
                        "shadow": "none",
                        "p": 0,
                        "style": {
                          "backgroundColor": "transparent",
                          "width": "min(36rem, calc(100vw - 3rem))"
                        },
                        "styles": {
                          "root": {
                            "gridColumn": "auto",
                            "gridRow": "auto"
                          }
                        },
                        "px": 0,
                        "py": 0
                      },
                      "elementPaperProps": {
                        "withBorder": false,
                        "shadow": "none",
                        "p": 0,
                        "style": {
                          "backgroundColor": "transparent",
                          "minWidth": 0,
                          "width": "100%"
                        },
                        "styles": {
                          "root": {
                            "gridColumn": "auto",
                            "gridRow": "auto"
                          }
                        },
                        "px": 0,
                        "py": 0
                      },
                      "exportPaperProps": {
                        "withBorder": false,
                        "shadow": "none",
                        "p": 0,
                        "style": {
                          "backgroundColor": "transparent",
                          "margin": 0,
                          "width": "100%"
                        },
                        "styles": {
                          "root": {
                            "gridColumn": "auto",
                            "gridRow": "auto"
                          }
                        },
                        "px": 0,
                        "py": 0
                      },
                      "submitButtonProps": {
                        "fullWidth": true,
                        "fw": 600,
                        "mt": 0,
                        "h": "2.5rem",
                        "px": "1.25rem",
                        "style": {
                          "--mantine-color-disabled": "#d9d9d9",
                          "--mantine-color-disabled-color": "#4b4b4b",
                          "maxWidth": "100%"
                        }
                      }
                    }
                  },
                  "AppBuilderActionComponent": {
                    "defaultProps": {
                      "variant": "filled",
                      "color": "kastNeutral",
                      "radius": "xl",
                      "fw": 500,
                      "size": "sm",
                      "w": {
                        "base": "100%",
                        "md": "auto"
                      },
                      "style": {
                        "--button-bg": "var(--mantine-color-kastNeutral-filled)",
                        "--button-bd": "calc(0.0625rem * var(--mantine-scale)) solid transparent",
                        "--button-color": "#ffffff",
                        "--button-hover": "var(--mantine-color-kastNeutral-filled-hover)",
                        "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent",
                        "backgroundColor": "var(--mantine-color-kastNeutral-filled)",
                        "color": "#ffffff",
                        "height": "2.5rem",
                        "maxWidth": "calc(100% - 1.5rem)",
                        "minWidth": 0,
                        "paddingInline": "1.25rem"
                      },
                      "actionIconProps": {
                        "size": "2.5rem",
                        "variant": "default",
                        "style": {
                          "border": "calc(0.0625rem * var(--mantine-scale)) solid transparent",
                          "backgroundColor": "var(--mantine-color-kastNeutral-filled)",
                          "color": "#ffffff"
                        }
                      }
                    }
                  },
                  "AppBuilderTextWidgetComponent": {
                    "defaultProps": {
                      "p": 0,
                      "withBorder": false,
                      "shadow": "none",
                      "bg": "transparent",
                      "w": {
                        "base": "auto",
                        "md": "auto"
                      },
                      "styles": {
                        "root": {
                          "alignItems": "center",
                          "display": "flex",
                          "fontSize": "1.25rem",
                          "height": "auto",
                          "marginLeft": "auto",
                          "minHeight": 0,
                          "overflow": "clip",
                          "padding": "0 !important",
                          "whiteSpace": "nowrap",
                          "maxHeight": "40px"
                        }
                      }
                    }
                  },
                  "MarkdownWidgetComponent": {
                    "defaultProps": {
                      "style": {
                        "marginLeft": "auto",
                        "margin-left": "auto"
                      },
                      "setHeadingFontSize": true,
                      "themeOverride": {
                        "headings": {
                          "sizes": {
                            "h2": {
                              "fontSize": "1.75rem",
                              "lineHeight": "1.1"
                            },
                            "h3": {
                              "fontSize": "1.5rem",
                              "lineHeight": "1.1"
                            }
                          }
                        },
                        "components": {
                          "Title": {
                            "defaultProps": {
                              "mb": 0
                            },
                            "styles": {
                              "root": {
                                "lineHeight": "1.1",
                                "marginBottom": "0"
                              }
                            }
                          },
                          "Text": {
                            "defaultProps": {
                              "mb": 0
                            },
                            "styles": {
                              "root": {
                                "fontSize": "1.25rem",
                                "marginBottom": "0"
                              }
                            }
                          }
                        }
                      }
                    }
                  },
                  "ParameterLabelComponent": {
                    "defaultProps": {
                      "display": "none"
                    }
                  }
                }
              }
            }
          }
        }
      },
      "Paper": {
        "defaultProps": {
          "withBorder": true,
          "shadow": "none",
          "radius": "6px",
          "bg": "#ffffff"
        }
      },
      "Stack": {
        "defaultProps": {
          "gap": 4
        }
      },
      "AppBuilderControlsWidgetComponent": {
        "defaultProps": {
          "stackProps": {
            "gap": 4
          },
          "elementPaperProps": {
            "p": 4,
            "withBorder": false,
            "shadow": "none",
            "radius": "6px",
            "bg": "#f0f0f0"
          }
        }
      },
      "Button": {
        "defaultProps": {
          "variant": "default",
          "radius": "xl",
          "fw": 500,
          "size": "sm"
        }
      },
      "Tabs": {
        "defaultProps": {
          "variant": "default",
          "color": "dark",
          "style": {
            "--mantine-color-body": "#f0f0f0",
            "--mantine-color-default": "#ffffff",
            "--mantine-color-default-hover": "#ffffff",
            "--mantine-color-default-border": "#d9d9d9"
          }
        }
      },
      "Text": {
        "defaultProps": {
          "c": "#2b2b2b",
          "fw": 400
        }
      },
      "Switch": {
        "defaultProps": {
          "color": "dark",
          "size": "sm"
        }
      },
      "ViewportIconButton": {
        "defaultProps": {
          "actionIconProps": {
            "size": 24,
            "style": {
              "margin": "0.188rem"
            }
          },
          "iconProps": {
            "style": {
              "width": 12,
              "height": 12
            },
            "strokeWidth": 1.5
          }
        }
      },
      "SelectGridComponent": {
        "defaultProps": {
          "gridProps": {
            "cols": 3,
            "spacing": 4
          },
          "cardProps": {
            "p": 2,
            "px": 2,
            "py": 2,
            "radius": "6px",
            "bg": "#ffffff",
            "style": {
              "--card-selected-color": "#2b2b2b",
              "backgroundColor": "#ffffff"
            }
          },
          "stackProps": {
            "gap": 2
          },
          "imageProps": {
            "fit": "contain",
            "w": "100%",
            "h": "100%",
            "fallbackSrc": "not-found.svg",
            "style": {
              "width": "100%",
              "height": "100%",
              "top": "0",
              "left": "0",
              "objectFit": "contain"
            }
          },
          "labelProps": {
            "size": "xs",
            "fontWeight": "400",
            "ta": "center",
            "style": {
              "textAlign": "center",
              "width": "100%",
              "paddingBottom": "6px"
            }
          }
        }
      },
      "SelectCarouselComponent": {
        "defaultProps": {
          "carouselProps": {
            "slideGap": 4,
            "slideSize": {
              "base": "33.333333%"
            },
            "emblaOptions": {
              "align": "start",
              "loop": true,
              "slidesToScroll": 1
            }
          },
          "cardProps": {
            "p": 2,
            "px": 2,
            "py": 2,
            "radius": "6px",
            "bg": "#ffffff",
            "style": {
              "--card-selected-color": "#2b2b2b",
              "backgroundColor": "#ffffff"
            }
          },
          "stackProps": {
            "gap": 2
          },
          "imageProps": {
            "fit": "contain",
            "w": "100%",
            "h": "100%",
            "fallbackSrc": "not-found.svg",
            "style": {
              "width": "100%",
              "height": "100%",
              "top": "0",
              "left": "0",
              "objectFit": "contain"
            }
          },
          "labelProps": {
            "size": "xs",
            "fontWeight": "400",
            "ta": "center",
            "style": {
              "textAlign": "center",
              "width": "100%",
              "paddingBottom": "6px"
            }
          }
        }
      },
      "AppBuilderImage": {
        "defaultProps": {
          "withBorder": false,
          "radius": "6px",
          "fit": "contain",
          "w": "100%",
          "h": "100%"
        }
      },
      "ParameterLabelComponent": {
        "defaultProps": {
          "fontWeight": "500"
        }
      },
      "ParameterSelectComponent": {
        "defaultProps": {
          "componentSettings": {}
        }
      },
      "ViewportBranding": {
        "defaultProps": {
          "light": {
            "backgroundColor": "#e3e3e3"
          }
        }
      },
      "ViewportAnchor2d": {
        "defaultProps": {
          "mobileBreakpoint": "anchorAlways",
          "anchorPaperProps": {
            "pos": {
              "base": "fixed",
              "md": "relative"
            },
            "top": {
              "base": "0.75rem",
              "md": "auto"
            },
            "right": {
              "base": "1rem",
              "md": "auto"
            },
            "bottom": {
              "base": "auto",
              "md": "auto"
            },
            "left": {
              "base": "auto",
              "md": "auto"
            },
            "style": {
              "zIndex": 10000
            }
          },
          "anchorStackProps": {
            "style": {
              "position": "relative",
              "zIndex": 20
            }
          }
        }
      },
      "ViewportIcons": {
        "defaultProps": {
          "color": "#2b2b2b",
          "colorDisabled": "#cdcdcd",
          "variant": "subtle",
          "variantDisabled": "transparent",
          "size": 24,
          "iconStyle": {
            "width": 12,
            "height": 12,
            "strokeWidth": 1.5
          }
        }
      },
      "ViewportOverlayWrapper": {
        "defaultProps": {
          "position": "bottom-right"
        }
      },
      "AppShell": {
        "defaultProps": {
          "styles": {
            "navbar": {
              "display": "grid",
              "gridTemplateRows": "0 minmax(0, 1fr)",
              "overflowX": "hidden",
              "overflowY": "auto"
            }
          }
        }
      }
    }
  }
}
